{
  "manifest_version": 3,
  "name": "Leadrr - Google Maps Lead Generator",
  "version": "1.0.0",
  "description": "Automatically scrolls and extracts business leads from Google Maps. Exports directly to Excel/CSV.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.google.com/maps/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/leadrr_logo.png",
    "32": "icons/leadrr_logo.png",
    "48": "icons/leadrr_logo.png",
    "128": "icons/leadrr_logo.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/leadrr_logo.png",
      "32": "icons/leadrr_logo.png",
      "48": "icons/leadrr_logo.png",
      "128": "icons/leadrr_logo.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/maps/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}
